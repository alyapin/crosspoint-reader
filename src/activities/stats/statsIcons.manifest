# Lucide icons for the statistics and shelf screens — regenerate from the
# repository root with:
#   python3 freeink-sdk/libs/assets/Icons/tools/gen_icons.py \
#     --manifest src/activities/stats/statsIcons.manifest \
#     --svgdir freeink-sdk/libs/assets/Icons/lucide/icons \
#     --sizes 24,32 --out src/activities/stats/statsIcons.h
# book, book-open, library and trash-2 come from components/icons/listIcons.h.
plus = plus
check = check
pause = pause
pencil = pencil
x = x
