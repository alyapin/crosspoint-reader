# Lucide icons for the game screens and their pickers — regenerate from the
# repository root with:
#   python3 freeink-sdk/libs/assets/Icons/tools/gen_icons.py \
#     --manifest src/games/ui/gameIcons.manifest \
#     --svgdir freeink-sdk/libs/assets/Icons/lucide/icons \
#     --sizes 24 --out src/games/ui/gameIcons.h
grid = grid-3x3
grid-small = grid-2x2
bomb = bomb
spade = spade
fifteen = blocks
card = rectangle-vertical
cards = layers
circle-check = circle-check
tictactoe = hash
tiles = layout-grid
hangman = baseline
hangman-rude = flame
reversi = contrast
# action bar (games/ui/ActionBar.h)
bar-notes = pencil
bar-erase = eraser
bar-undo = undo-2
bar-flag = flag
bar-restart = rotate-ccw
bar-new-game = plus
bar-hint = lightbulb
# pause menu (button boards)
exit = log-out
# «5 букв»: games list, keyboard
five-letters = spell-check
key-delete = delete
key-enter = corner-down-left
# Японские кроссворды: games list, picker, bar
nonogram = grid-2x2-check
pictures = image
random = dices
bar-cross = x
# Шашки: games list, «Сдаться» in the menu
draughts = disc-2
surrender = hand
# Кейворды: games list
codeword = binary
